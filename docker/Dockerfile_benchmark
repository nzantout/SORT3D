FROM nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04

# Env vars for the nvidia-container-runtime.
ENV NVIDIA_VISIBLE_DEVICES all
ENV NVIDIA_DRIVER_CAPABILITIES graphics,utility,compute

RUN apt-get update
RUN apt-get install -y unzip sudo git wget python3-pip
RUN apt-get install -y ffmpeg libsm6 libxext6 libgtk-3-dev libxkbcommon-x11-0 vulkan-tools

RUN apt-get update
RUN apt-get install -y wget && rm -rf /var/lib/apt/lists/*

ARG USERNAME=sort3d
RUN useradd -ms /bin/bash ${USERNAME} 
RUN echo "$USERNAME ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

USER root

USER ${USERNAME}
WORKDIR /home/${USERNAME}

RUN sudo pip3 install --upgrade pip
RUN sudo pip3 install --no-cache-dir plyfile tqdm numpy shapely scipy numba matplotlib pandas opencv-python imageio 
RUN sudo pip3 install --no-cache-dir mistralai torch torchvision langchain langgraph spacy  open_clip_torch transformers langchain-mistralai

RUN python3 -m spacy download en_core_web_sm

# Setup environment
SHELL ["/bin/bash", "-l", "-c"]